generator client {
  provider = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "mysql"
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionDirection {
  IN
  OUT
}

enum PurchaseRequestStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  PAID
  CANCELLED
}

enum PurchaseApprovalAction {
  APPROVE
  REJECT
}

enum TransactionAdjustmentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CurrencyConversionStatus {
  PENDING
  FAILED
  SUCCEEDED
}

enum PurchaseRequestKind {
  PURCHASE
  COLLECTION
}

enum ExternalReceivableStatus {
  OPEN
  PARTIAL
  PAID
  CANCELLED
}

model User {
  id               String                @id @default(cuid())
  email            String                @unique
  passwordHash     String                @map("password_hash")
  fullName         String                @map("full_name")
  status           UserStatus            @default(ACTIVE)
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")
  roles            UserRole[]
  purchaseRequests PurchaseRequest[]
  walletPurchaseRequests PurchaseRequest[] @relation("PurchaseRequestWalletOwner")
  approvals        PurchaseRequestApproval[]
  transactionsMade Transaction[]         @relation("TransactionCreatedBy")
  transactionsOk   Transaction[]         @relation("TransactionApprovedBy")
  transactionTeamLinks TransactionTeamUser[] @relation("TransactionTeamUser")
  receiptImages    ReceiptImage[]        @relation("ReceiptUploadedBy")
  currencyConversions CurrencyConversion[] @relation("CurrencyConversionCreatedBy")
  decidedCurrencyConversions CurrencyConversion[] @relation("CurrencyConversionDecidedBy")
  externalReceivables ExternalReceivable[] @relation("ExternalReceivableCreatedBy")
  externalReceivablePayments ExternalReceivablePayment[] @relation("ExternalReceivablePaymentCreatedBy")
  auditLogs        AuditLog[]
  requestedTransactionAdjustments TransactionAdjustment[] @relation("TransactionAdjustmentRequestedBy")
  approvedTransactionAdjustments  TransactionAdjustment[] @relation("TransactionAdjustmentApprovedBy")

  @@map("users")
}

model Role {
  id          String           @id @default(cuid())
  code        String           @unique
  name        String
  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id    String           @id @default(cuid())
  code  String           @unique
  name  String
  roles RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId String @map("user_id")
  roleId String @map("role_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model TransactionCategory {
  id                            String            @id @default(cuid())
  code                          String            @unique
  name                          String
  note                          String?           @db.VarChar(255)
  contactEmail                  String?           @map("contact_email") @db.VarChar(191)
  type                          TransactionType
  parentId                      String?           @map("parent_id")
  accountantApprovalThresholdVnd Int?              @map("accountant_approval_threshold_vnd")
  isActive                      Boolean           @default(true) @map("is_active")
  createdAt                     DateTime          @default(now()) @map("created_at")
  updatedAt                     DateTime          @updatedAt @map("updated_at")
  parent                        TransactionCategory? @relation("CategoryChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children                      TransactionCategory[] @relation("CategoryChildren")
  transactions                  Transaction[]
  requests                      PurchaseRequest[]

  @@index([parentId])
  @@map("transaction_categories")
}

model Currency {
  code        String         @id
  name        String
  precision   Int            @default(2)
  ratesFrom   ExchangeRate[] @relation("RatesFrom")
  ratesTo     ExchangeRate[] @relation("RatesTo")
  transactions Transaction[]
  requests    PurchaseRequest[]
  externalReceivables ExternalReceivable[]
  externalReceivablePayments ExternalReceivablePayment[]

  @@map("currencies")
}

model PaymentAccount {
  id            String        @id @default(cuid())
  accountName   String        @map("account_name")
  bankName      String        @map("bank_name")
  accountNumber String        @map("account_number")
  ownerName     String        @map("owner_name")
  isActive      Boolean       @default(true) @map("is_active")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  transactions  Transaction[]
  currencyConversions CurrencyConversion[] @relation("CurrencyConversionWallet")
  currencyConversionReceives CurrencyConversion[] @relation("CurrencyConversionReceive")
  externalReceivablePayments ExternalReceivablePayment[]

  @@index([isActive, accountName])
  @@map("payment_accounts")
}

model ExchangeRate {
  id           String   @id @default(cuid())
  fromCurrency String   @map("from_currency")
  toCurrency   String   @map("to_currency")
  rate         Decimal  @db.Decimal(20, 4)
  source       String
  effectiveFrom DateTime @map("effective_from")
  createdAt    DateTime @default(now()) @map("created_at")
  from         Currency @relation("RatesFrom", fields: [fromCurrency], references: [code])
  to           Currency @relation("RatesTo", fields: [toCurrency], references: [code])

  @@index([fromCurrency, toCurrency, effectiveFrom])
  @@map("exchange_rates")
}

model ExternalParty {
  id           String               @id @default(cuid())
  name         String
  type         String               @default("OTHER")
  contactName  String?              @map("contact_name") @db.VarChar(191)
  contactPhone String?              @map("contact_phone") @db.VarChar(50)
  contactEmail String?              @map("contact_email") @db.VarChar(191)
  note         String?              @db.Text
  isActive     Boolean              @default(true) @map("is_active")
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")
  receivables  ExternalReceivable[]

  @@index([isActive, name])
  @@map("external_parties")
}

model ExternalReceivable {
  id                String                      @id @default(cuid())
  partyId           String                      @map("party_id")
  title             String
  description       String?                     @db.Text
  amountOriginal    Decimal                     @db.Decimal(20, 4) @map("amount_original")
  currencyCode      String                      @map("currency_code")
  exchangeRateToVnd Decimal                     @db.Decimal(20, 4) @map("exchange_rate_to_vnd")
  amountVnd         Decimal                     @db.Decimal(20, 4) @map("amount_vnd")
  occurredAt        DateTime                    @map("occurred_at")
  dueDate           DateTime?                   @map("due_date")
  status            ExternalReceivableStatus    @default(OPEN)
  createdBy         String                      @map("created_by")
  cancelledAt       DateTime?                   @map("cancelled_at")
  createdAt         DateTime                    @default(now()) @map("created_at")
  updatedAt         DateTime                    @updatedAt @map("updated_at")
  party             ExternalParty               @relation(fields: [partyId], references: [id])
  currency          Currency                    @relation(fields: [currencyCode], references: [code])
  creator           User                        @relation("ExternalReceivableCreatedBy", fields: [createdBy], references: [id])
  payments          ExternalReceivablePayment[]

  @@index([partyId, status])
  @@index([status, occurredAt])
  @@index([createdBy])
  @@map("external_receivables")
}

model ExternalReceivablePayment {
  id                   String             @id @default(cuid())
  receivableId         String             @map("receivable_id")
  amountOriginal       Decimal            @db.Decimal(20, 4) @map("amount_original")
  currencyCode         String             @map("currency_code")
  exchangeRateToVnd    Decimal            @db.Decimal(20, 4) @map("exchange_rate_to_vnd")
  amountVnd            Decimal            @db.Decimal(20, 4) @map("amount_vnd")
  paymentDate          DateTime           @map("payment_date")
  paymentAccountId     String?            @map("payment_account_id")
  note                 String?            @db.Text
  receiptImagePath     String?            @map("receipt_image_path") @db.VarChar(512)
  receiptImageName     String?            @map("receipt_image_name") @db.VarChar(255)
  receiptImageMimeType String?            @map("receipt_image_mime_type")
  receiptImageSize     Int?               @map("receipt_image_size")
  createdBy            String             @map("created_by")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")
  receivable           ExternalReceivable @relation(fields: [receivableId], references: [id], onDelete: Cascade)
  currency             Currency           @relation(fields: [currencyCode], references: [code])
  paymentAccount       PaymentAccount?    @relation(fields: [paymentAccountId], references: [id], onDelete: SetNull)
  creator              User               @relation("ExternalReceivablePaymentCreatedBy", fields: [createdBy], references: [id])

  @@index([receivableId, paymentDate])
  @@index([paymentAccountId])
  @@index([createdBy])
  @@map("external_receivable_payments")
}

model PurchaseRequest {
  id             String                  @id @default(cuid())
  requesterId    String                  @map("requester_id")
  categoryId     String?                 @map("category_id")
  title          String
  description    String
  kind           PurchaseRequestKind     @default(PURCHASE)
  expectedAmount Decimal                 @db.Decimal(20, 4) @map("expected_amount")
  currencyCode   String                  @map("currency_code")
  tags           String?                 @db.Text
  workshopEmail  String?                 @map("workshop_email") @db.VarChar(191)
  // Account wallet: an ACCOUNT member buys stock (isWalletStock), other staff buy it back
  // (walletOwnerId), and the system raises a collection request that credits the wallet.
  isWalletStock  Boolean                 @default(false) @map("is_wallet_stock")
  walletOwnerId  String?                 @map("wallet_owner_id")
  walletSourceRequestId String?          @map("wallet_source_request_id")
  status         PurchaseRequestStatus   @default(DRAFT)
  createdAt      DateTime                @default(now()) @map("created_at")
  updatedAt      DateTime                @updatedAt @map("updated_at")
  requester      User                    @relation(fields: [requesterId], references: [id])
  category       TransactionCategory?    @relation(fields: [categoryId], references: [id])
  currency       Currency                @relation(fields: [currencyCode], references: [code])
  items          PurchaseRequestItem[]
  approvals      PurchaseRequestApproval[]
  transactions   Transaction[]
  receiptImages  ReceiptImage[]
  currencyConversions CurrencyConversionRequest[]
  walletOwner    User?                   @relation("PurchaseRequestWalletOwner", fields: [walletOwnerId], references: [id], onDelete: SetNull)
  walletSourceRequest   PurchaseRequest?  @relation("PurchaseRequestWalletSource", fields: [walletSourceRequestId], references: [id], onDelete: Cascade)
  walletDerivedRequests PurchaseRequest[] @relation("PurchaseRequestWalletSource")

  @@index([requesterId, status])
  @@index([walletOwnerId])
  @@index([walletSourceRequestId])
  @@index([categoryId])
  @@index([kind, status])
  @@map("purchase_requests")
}

model CurrencyConversion {
  id                    String                      @id @default(cuid())
  walletPaymentAccountId String?                     @map("wallet_payment_account_id")
  receivePaymentAccountId String?                    @map("receive_payment_account_id")
  walletName            String                      @map("wallet_name")
  bankName              String                      @map("bank_name")
  accountNumber         String                      @map("account_number")
  ownerName             String                      @map("owner_name")
  amountUsd             Decimal                     @db.Decimal(20, 4) @map("amount_usd")
  amountVnd             Decimal                     @db.Decimal(20, 4) @map("amount_vnd")
  notes                 String?                     @db.Text
  transferTransactionId String?                     @map("transfer_transaction_id") @db.VarChar(191)
  receiveTransactionId  String?                     @map("receive_transaction_id") @db.VarChar(191)
  pingpongImagePath     String                      @map("pingpong_image_path") @db.VarChar(512)
  pingpongImageName     String                      @map("pingpong_image_name") @db.VarChar(255)
  pingpongImageMimeType String                      @map("pingpong_image_mime_type")
  pingpongImageSize     Int                         @map("pingpong_image_size")
  transferImagePath     String?                     @map("transfer_image_path") @db.VarChar(512)
  transferImageName     String?                     @map("transfer_image_name") @db.VarChar(255)
  transferImageMimeType String?                     @map("transfer_image_mime_type")
  transferImageSize     Int?                        @map("transfer_image_size")
  status                CurrencyConversionStatus    @default(PENDING)
  createdBy             String                      @map("created_by")
  decidedBy             String?                     @map("decided_by")
  decidedAt             DateTime?                   @map("decided_at")
  createdAt             DateTime                    @default(now()) @map("created_at")
  updatedAt             DateTime                    @updatedAt @map("updated_at")
  walletPaymentAccount  PaymentAccount?             @relation("CurrencyConversionWallet", fields: [walletPaymentAccountId], references: [id], onDelete: SetNull)
  receivePaymentAccount PaymentAccount?             @relation("CurrencyConversionReceive", fields: [receivePaymentAccountId], references: [id], onDelete: SetNull)
  creator               User                        @relation("CurrencyConversionCreatedBy", fields: [createdBy], references: [id])
  decider               User?                       @relation("CurrencyConversionDecidedBy", fields: [decidedBy], references: [id], onDelete: SetNull)
  requests              CurrencyConversionRequest[]

  @@index([status, createdAt])
  @@index([createdAt])
  @@index([createdBy])
  @@index([decidedBy])
  @@index([walletPaymentAccountId])
  @@index([receivePaymentAccountId])
  @@map("currency_conversions")
}

model CurrencyConversionRequest {
  conversionId      String             @map("conversion_id")
  purchaseRequestId String             @map("purchase_request_id")
  conversion        CurrencyConversion @relation(fields: [conversionId], references: [id], onDelete: Cascade)
  purchaseRequest   PurchaseRequest    @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)

  @@id([conversionId, purchaseRequestId])
  @@unique([purchaseRequestId])
  @@index([purchaseRequestId])
  @@map("currency_conversion_requests")
}

model PurchaseRequestItem {
  id           String          @id @default(cuid())
  requestId    String          @map("request_id")
  itemName     String          @map("item_name")
  qty          Decimal         @db.Decimal(20, 4)
  unitPrice    Decimal         @db.Decimal(20, 4) @map("unit_price")
  currencyCode String          @map("currency_code")
  subtotal     Decimal         @db.Decimal(20, 4)
  request      PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@map("purchase_request_items")
}

model PurchaseRequestApproval {
  id        String                 @id @default(cuid())
  requestId String                 @map("request_id")
  action    PurchaseApprovalAction
  actorId   String                 @map("actor_id")
  note      String
  actedAt   DateTime               @default(now()) @map("acted_at")
  request   PurchaseRequest        @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actor     User                   @relation(fields: [actorId], references: [id])

  @@index([requestId, actedAt])
  @@map("purchase_request_approvals")
}

model Transaction {
  id                 String               @id @default(cuid())
  direction          TransactionDirection
  categoryId         String               @map("category_id")
  amountOriginal     Decimal              @db.Decimal(20, 4) @map("amount_original")
  currencyCode       String               @map("currency_code")
  exchangeRateToVnd  Decimal              @db.Decimal(20, 4) @map("exchange_rate_to_vnd")
  amountVnd          Decimal              @db.Decimal(20, 4) @map("amount_vnd")
  description        String
  notes              Json?
  transactionRef     String?              @map("transaction_ref") @db.VarChar(191)
  workshopEmail      String?              @map("workshop_email") @db.VarChar(191)
  transactionDate    DateTime             @map("transaction_date")
  paymentMethod      String               @map("payment_method")
  paymentAccountId   String?              @map("payment_account_id")
  createdBy          String               @map("created_by")
  approvedBy         String?              @map("approved_by")
  purchaseRequestId  String?              @map("purchase_request_id")
  status             String               @default("RECORDED")
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")
  teamUsers          TransactionTeamUser[]
  category           TransactionCategory  @relation(fields: [categoryId], references: [id])
  currency           Currency             @relation(fields: [currencyCode], references: [code])
  creator            User                 @relation("TransactionCreatedBy", fields: [createdBy], references: [id])
  approver           User?                @relation("TransactionApprovedBy", fields: [approvedBy], references: [id])
  purchaseRequest    PurchaseRequest?     @relation(fields: [purchaseRequestId], references: [id])
  paymentAccount     PaymentAccount?      @relation(fields: [paymentAccountId], references: [id], onDelete: SetNull)
  receiptImages      ReceiptImage[]
  adjustments        TransactionAdjustment[]

  @@index([transactionDate, status])
  @@index([categoryId])
  @@index([paymentAccountId])
  @@map("transactions")
}

model TransactionTeamUser {
  transactionId String      @map("transaction_id")
  userId        String      @map("user_id")
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  user          User        @relation("TransactionTeamUser", fields: [userId], references: [id], onDelete: Cascade)

  @@id([transactionId, userId])
  @@index([userId])
  @@map("transaction_team_users")
}

model TransactionAdjustment {
  id            String                    @id @default(cuid())
  transactionId String                    @map("transaction_id")
  requestedBy   String                    @map("requested_by")
  approvedBy    String?                   @map("approved_by")
  status        TransactionAdjustmentStatus @default(PENDING)
  reason        String
  reviewNote    String?                   @map("review_note")
  beforePayload Json?                     @map("before_payload")
  afterPayload  Json?                     @map("after_payload")
  payload       Json
  requestedAt   DateTime                  @default(now()) @map("requested_at")
  decidedAt     DateTime?                 @map("decided_at")
  createdAt     DateTime                  @default(now()) @map("created_at")
  updatedAt     DateTime                  @updatedAt @map("updated_at")
  transaction   Transaction               @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  requester     User                      @relation("TransactionAdjustmentRequestedBy", fields: [requestedBy], references: [id])
  approver      User?                     @relation("TransactionAdjustmentApprovedBy", fields: [approvedBy], references: [id])

  @@index([transactionId, requestedAt])
  @@index([status, requestedAt])
  @@map("transaction_adjustments")
}

model ReceiptImage {
  id                String          @id @default(cuid())
  purchaseRequestId String?         @map("purchase_request_id")
  transactionId     String?         @map("transaction_id")
  uploadedBy        String          @map("uploaded_by")
  filePath          String          @map("file_path") @db.VarChar(512)
  fileName          String          @map("file_name") @db.VarChar(255)
  mimeType          String          @map("mime_type")
  size              Int
  createdAt         DateTime        @default(now()) @map("created_at")
  purchaseRequest   PurchaseRequest? @relation(fields: [purchaseRequestId], references: [id], onDelete: SetNull)
  transaction       Transaction?    @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  uploader          User            @relation("ReceiptUploadedBy", fields: [uploadedBy], references: [id])

  @@index([purchaseRequestId, createdAt])
  @@index([transactionId])
  @@map("receipt_images")
}

model AuditLog {
  id                String   @id @default(cuid())
  actorId           String?  @map("actor_id")
  actorRoleSnapshot String   @map("actor_role_snapshot")
  action            String
  entityType        String   @map("entity_type")
  entityId          String   @map("entity_id")
  beforeData        Json?    @map("before_data")
  afterData         Json?    @map("after_data")
  ipAddress         String?  @map("ip_address")
  userAgent         String?  @map("user_agent")
  requestId         String   @map("request_id")
  createdAt         DateTime @default(now()) @map("created_at")
  actor             User?    @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

model AppSetting {
  key       String   @id
  value     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}
